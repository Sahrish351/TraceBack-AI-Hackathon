# TraceBack AI Environment Configuration
PORT=4000
NODE_ENV=development

# Zetaris Data Virtualization Layer
# Leave blank to run in ZETARIS MOCK mode (in-memory SQLite JOINs across CSVs)
ZETARIS_API_URL=https://api.zetaris.io/v1
ZETARIS_API_KEY=

# Meterless Agent Orchestration Layer
# Leave blank to run local Meterless Mission orchestrator (Scout Intent -> Relay Execution -> H-MEM)
METERLESS_API_URL=https://api.meterless.ai/v1
METERLESS_API_KEY=

# NVIDIA NIM (Inference Microservice)
# Uses meta/llama-3.1-8b-instruct for natural language explanations & supplier emails
# Leave blank to use high-fidelity deterministic fallback model
NVIDIA_API_KEY=
